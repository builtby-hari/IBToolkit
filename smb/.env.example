# Copy to .env and fill in values. Never commit .env.
# Values stay blank in this file on purpose.

# Telegram alerts (used by `screen --alert`).
# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=
# Chat ID of the private chat that receives alerts.
TELEGRAM_CHAT_ID=

# Reserved for planned features. No code reads these yet; leaving them blank is fine.
# FRED API key (free). Rates come from the no-key CSV endpoint today; reserved for a
# possible move to the JSON API (DPRIME and DGS10).
FRED_API_KEY=
# Census API key (free). Reserved for the planned County Business Patterns loader
# (census_cbp.py, not built).
CENSUS_API_KEY=
# Socrata app token for data.texas.gov (optional). Reserved for the planned Texas
# Comptroller loader (tx_context.py, not built).
SOCRATA_APP_TOKEN=

# TABC permit data and Texas Comptroller sales tax files are public downloads and need no key.
